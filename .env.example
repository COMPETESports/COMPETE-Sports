# ---- Database (required) -------------------------------------------------
# Supabase -> Connect -> "Transaction pooler" tab.
# Replace [YOUR-PASSWORD] with the database password you chose at project
# creation, and append ?sslmode=require to the end.
#
# PORT MUST BE 6543. The direct connection on 5432 will not survive
# serverless traffic — the driver here is configured for the pooler
# (prepare: false), and the two are not interchangeable.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require"

# ---- Admin access (required to use /admin) -------------------------------
# Two secrets you invent. Generate each with: openssl rand -base64 32
#
# SESSION_SECRET signs session cookies — changing it logs everyone out.
# ADMIN_PASSWORD is the only thing between the internet and /admin, so make
# it a real passphrase.
ADMIN_PASSWORD=""
SESSION_SECRET=""

# ---- Site ---------------------------------------------------------------
# Password-reset and email-verification links are built from this. If it is
# wrong in production, those emails send people to the wrong host.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # https://joincompete.com in production

# ---- Google sign-in (optional) -------------------------------------------
# Leave blank and the Google buttons do not appear at all, rather than
# appearing and failing. Google requires a published privacy policy URL
# before it will approve the consent screen — that is /privacy.
# Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Google Maps / Places (optional, for the partner CRM) ----------------
# TWO keys, because they are protected by two different mechanisms and a
# single key cannot have both. Set up 9 Oct 2026.
#
# BROWSER KEY — ships inside the page, so it cannot be kept secret. Google
# is told to accept it only when the request comes from our own domains,
# which is what makes a copied key useless. Locked to Maps JavaScript API.
# Referrers: https://joincompete.com/*, https://*.vercel.app/*,
#            http://localhost:3000/*
#
# Nothing reads this yet. The Communities map is pre-rendered SVG from
# Census boundaries (scripts/build-map.ts) and ships no mapping library at
# all, so leaving this blank costs nothing today. It exists for whenever a
# real interactive map arrives.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# SERVER KEY — never reaches a browser. Used by partner-CRM contact
# enrichment: 258 of 295 organizations have no contact route, and a Places
# lookup on name + city recovers a meaningful share of them.
#
# Application restrictions MUST be None: Vercel's serverless IPs are not
# static, so there is no address to whitelist and a referrer check would
# reject every server-side call. The only control is the API restriction —
# Places and nothing else — which bounds what a leak could reach.
#
# NO NEXT_PUBLIC_ PREFIX. That prefix inlines a value into the client
# bundle, which would publish an unrestricted-by-referrer key to every
# visitor.
#
# Verify both with: node scripts/verify-google-keys.mjs
GOOGLE_PLACES_KEY=""

# ---- Email (optional, but see the note) ----------------------------------
# Without a key, email is written to the server log instead of being sent.
# Fine locally. NOT fine in production: this is also how the age-gate
# compliance alerts go out, and /admin/compliance will show them as
# "not sent" until a key exists.
RESEND_API_KEY=""
MAIL_FROM="COMPETE <hello@joincompete.com>"

# Where age-bracket change alerts are sent. Defaults to the CONTACT_EMAIL in
# src/lib/legal.ts when unset.
COMPLIANCE_EMAIL=""

# ---- Geocoding (NOT required) --------------------------------------------
# Deliberately absent: there is no MAPBOX_TOKEN any more.
#
# A US postal table is bundled into the app, which answers every ZIP code
# and "City, ST" with no network call, no key and no bill — which is all the
# search box asks for. Mapbox was only ever a last-resort fallback for text
# the table could not parse, and the code already returns null gracefully
# without it.
#
# If that fallback is ever wanted, the Google Geocoding API above covers it,
# so it stays one vendor rather than two.
